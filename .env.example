# ================================================
# Social-Commerce AI Inbox — Environment Variables
# ================================================
# Bu faylni .env deb nomlab, haqiqiy qiymatlarni kiriting.
# Hech qachon .env faylini Git'ga push qilmang!

# --- Django Core ---
# PRODUCTION CHECKLIST (before deploying to a real server — use
# docker-compose.prod.yml, see its header comment too):
#   1. SECRET_KEY   — generate a real one, e.g.:
#                      python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   2. DEBUG         — MUST be False. Leaving DEBUG=True on a public server
#                      exposes your secret key, stack traces, and disables
#                      the CORS_ALLOWED_ORIGINS restriction below.
#   3. ALLOWED_HOSTS — set to your real domain(s), e.g. "api.mystore.uz"
#      (ALLOWED_HOSTS=* only works because DEBUG=True forces it in settings.py)
#   4. DB_PASSWORD   — NEVER use the "strongpassword123" placeholder below
#                      in production — generate a real random one, e.g.:
#                      python -c "import secrets; print(secrets.token_urlsafe(24))"
#   5. TELEGRAM_WEBHOOK_SECRET / FIELD_ENCRYPTION_KEY — same rule, never
#      reuse a dev/example value — generate fresh per-server.
SECRET_KEY=your-very-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL Database ---
DB_NAME=ai_inbox_db
DB_USER=ai_inbox_user
DB_PASSWORD=strongpassword123
DB_HOST=localhost
DB_PORT=5432

# --- Redis (Celery Broker & Cache) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- AI API Keys ---
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here   # ixtiyoriy, agar Gemini ishlatilsa shart emas

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-token-here

# --- Maxfiy maydonlarni shifrlash (apps/core/fields.py) ---
# Yaratish: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-fernet-key-here

# --- Instagram / Meta ---
META_APP_ID=your-meta-app-id-here
META_APP_SECRET=your-meta-app-secret-here
META_VERIFY_TOKEN=your-custom-verify-token-here

# --- Sentry (Monitoring) ---
SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/project-id

# --- CORS (Frontend uchun) ---
# Faqat DEBUG=False (production) bo'lganda ishlatiladi — DEBUG=True bo'lsa
# barcha originlarga ruxsat beriladi (settings.py). Production'da bu yerga
# haqiqiy frontend domeningizni yozing, masalan:
# CORS_ALLOWED_ORIGINS=https://mystore.uz
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Public URL (production'da haqiqiy domeningiz bo'lishi kerak) ---
# Masalan: PUBLIC_URL=https://api.mystore.uz
# Frontend'dagi NEXT_PUBLIC_API_URL ham shu domenga (yoki nisbiy /api/v1'ga)
# mos ravishda yangilanib, ./deploy_twa.sh bilan qayta build qilinishi kerak.
PUBLIC_URL=

# --- HTTPS (domen + SSL sertifikat — masalan certbot — sozlangandan KEYIN) ---
# SSL hali yo'q bo'lsa (masalan yangi server, sertifikat hali olinmagan),
# bularni False/0 qoldiring — aks holda HTTP orqali kirish ishlamay qoladi.
# SSL tayyor bo'lgach: SECURE_SSL_REDIRECT=True va SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# --- Data Retention (kun hisobida) ---
CHAT_MESSAGE_RETENTION_DAYS=90
